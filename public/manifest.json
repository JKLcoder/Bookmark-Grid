{
  "manifest_version": 3,
  "name": "Bookmark Grid",
  "version": "1.8.0",
  "description": "一个轻量、私密的扁平化书签新标签页。",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "search",
    "alarms"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:"
  },
  "minimum_chrome_version": "108",
  "key": ""
}
